# stub: offline, deterministic agents (default). live: Claude API and the Claude Agent SDK.
VALXEL_MODE=stub
# Required only in live mode.
ANTHROPIC_API_KEY=
# Optional, live mode: other vendors for the roles models.yaml gives them (fallbacks, second
# opinions). A role whose provider isn't set here turns off with a warning.
OPENAI_API_KEY=
# A self-hosted OpenAI-compatible endpoint (vLLM serving an open-weight model), allowed PHI.
VALXEL_SELFHOSTED_URL=
VALXEL_SELFHOSTED_API_KEY=
# Unset to run fully in memory. docker compose sets this for you.
DATABASE_URL=postgresql://valxel:valxel@localhost:5432/valxel
# Where product governance is read from: local (examples/governance) or github.
VALXEL_GOVERNANCE_SOURCE=local
# github source, preferred: one GitHub App installed in the tools org and every product org.
VALXEL_GITHUB_APP_ID=
VALXEL_GITHUB_APP_PRIVATE_KEY_FILE=
# github source, alternative: a read-only token per org (VALXEL_GITHUB_TOKEN__<ORG>, '-' as '_')
# or one token for all orgs.
VALXEL_GITHUB_TOKEN__ACME_CLINIC=
VALXEL_GITHUB_TOKEN=
# Folder of installed plugins (<plugin>/skills/<skill>/SKILL.md). The image sets it to
# /opt/valxel/plugins; locally, point it at a knowledge-work-plugins checkout plus plugins/valxel.
# Live mode refuses to start while a skill the phases use is missing; stub mode uses placeholders.
VALXEL_SKILLS_DIR=

# Web interface sign-in: dev (pick any login and teams; local only) or github (OAuth).
VALXEL_AUTH=dev
# Signs the session cookie. At least 32 random characters, e.g. `openssl rand -hex 32`.
VALXEL_SESSION_SECRET=
# Where people reach the web interface. The OAuth callback is <this>/api/auth/callback.
VALXEL_PUBLIC_URL=http://localhost:8080
# GitHub OAuth app (Settings > Developer settings > OAuth Apps), owned by valxel-tools.
VALXEL_GITHUB_OAUTH_CLIENT_ID=
VALXEL_GITHUB_OAUTH_CLIENT_SECRET=

# Diagram and work-tracking tools, reached through their MCP servers (see config/tools.yaml).
# Each value is the full Authorization header. Unset = an offline stand-in for that provider.
# Lucid: an API key from the Lucid developer portal (Team or Enterprise; MCP enabled by an admin).
VALXEL_LUCID_MCP_AUTH=
# Jira through the Atlassian Rovo MCP server, with a service account's API token.
VALXEL_ATLASSIAN_MCP_AUTH=
VALXEL_ATLASSIAN_CLOUD_ID=
# OpenProject 17.2+ with the MCP server add-on: https://<instance>/mcp and an API token.
VALXEL_OPENPROJECT_MCP_URL=
VALXEL_OPENPROJECT_MCP_AUTH=

# Delivery: stub (default) keeps pull requests, CI, builds and deployments in memory.
# live opens real PRs through the GitHub App above and builds and deploys through OpenChoreo.
VALXEL_DELIVERY=stub
# The GitHub App's webhook secret; events go to <VALXEL_PUBLIC_URL>/api/webhooks/github.
VALXEL_GITHUB_WEBHOOK_SECRET=
# How often to poll CI and OpenChoreo for features waiting on them (webhooks make it immediate).
VALXEL_WATCH_INTERVAL_S=30
# OpenChoreo control plane MCP server and its confidential service client.
VALXEL_OPENCHOREO_MCP_URL=
VALXEL_OPENCHOREO_TOKEN_URL=
VALXEL_OPENCHOREO_CLIENT_ID=service_mcp_client
VALXEL_OPENCHOREO_CLIENT_SECRET=
VALXEL_OPENCHOREO_SCOPE=
VALXEL_OPENCHOREO_CONSOLE_URL=
