# stub: offline, deterministic agents (default). live: Claude API and the Claude Agent SDK.
VRIXEL_MODE=stub
# Required only in live mode.
ANTHROPIC_API_KEY=
# Unset to run fully in memory. docker compose sets this for you.
DATABASE_URL=postgresql://vrixel:vrixel@localhost:5432/vrixel
# Optional: folder holding installed plugins as <plugin>/skills/<skill>/SKILL.md.
VRIXEL_SKILLS_DIR=
