# stub: offline, deterministic agents (default). live: Claude API and the Claude Agent SDK.
VRIXEL_MODE=stub
# Required only in live mode.
ANTHROPIC_API_KEY=
# Unset to run fully in memory. docker compose sets this for you.
DATABASE_URL=postgresql://vrixel:vrixel@localhost:5432/vrixel
# Where product governance is read from: local (examples/governance) or github.
VRIXEL_GOVERNANCE_SOURCE=local
# github source, preferred: one GitHub App installed in the tools org and every product org.
VRIXEL_GITHUB_APP_ID=
VRIXEL_GITHUB_APP_PRIVATE_KEY_FILE=
# github source, alternative: a read-only token per org (VRIXEL_GITHUB_TOKEN__<ORG>, '-' as '_')
# or one token for all orgs.
VRIXEL_GITHUB_TOKEN__VRIXEL_EMR=
VRIXEL_GITHUB_TOKEN=
# Optional: folder holding installed plugins as <plugin>/skills/<skill>/SKILL.md.
VRIXEL_SKILLS_DIR=
