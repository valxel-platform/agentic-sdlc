# The laptop tier's settings (`valxel dev init` writes .env from this). Never commit .env.

# The model provider's key: only the LLM gateway reads it.
ANTHROPIC_API_KEY=
# The tool's key at the gateway (valxel dev init makes one and puts its SHA-256 in gateway-policy.yaml).
VALXEL_GATEWAY_KEY=

# GitHub: a token that may create repositories and open pull requests in the org(s) your products
# live in (a fine-grained token: Administration, Contents, Pull requests, Workflows, read and write),
# or the delivery GitHub App (VALXEL_GITHUB_APP_ID and VALXEL_GITHUB_APP_PRIVATE_KEY).
VALXEL_GITHUB_TOKEN=

# Governance: local reads the tool's examples (acme-* products); github reads each product org's
# governance repo with the token above.
VALXEL_GOVERNANCE_SOURCE=local

# The group that owns /var/run/docker.sock (stat -c %g /var/run/docker.sock); the worker joins it.
DOCKER_GID=0
